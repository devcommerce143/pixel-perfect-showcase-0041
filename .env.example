# Copy to .env.local for local overrides. Do not put secrets in any VITE_ variable.
# Leave VITE_API_MODE unset, or set it to mock, for local UI development.
# A production build rejects mock mode.

# VITE_API_MODE=mock

# Live mode requires every variable below. Values come from the environment owner.
# Do not invent hosts, realms, or client identifiers in this file.
# VITE_API_MODE=live
# VITE_API_BASE_URL=
# VITE_OIDC_ISSUER=
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_REDIRECT_URI=
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=
# Optional. Silent renewal stays off unless this public redirect URL is set.
# VITE_OIDC_SILENT_REDIRECT_URI=
